APP_URL=https://localhost/lexs_capstone
API_URL=http://127.0.0.1:3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lexsh_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

DOCUMENT_ENCRYPTION_KEY=replace-with-a-32-byte-secret-key
CASE_FILE_ENCRYPTION_KEY=replace-with-a-different-long-case-file-secret-key
JWT_SECRET=replace-with-a-long-random-secret

LOGIN_OTP_ENABLED=true
ADMIN_OTP_ENABLED=true
CLIENT_REGISTRATION_OTP_ENABLED=true

# SMTP is required when any email OTP setting is enabled.
# Gmail requires a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=lexshiled000@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=lexshiled000@gmail.com
SMTP_FROM_NAME=LEXSHIELD

MALWARE_SCAN_UPLOADS=true
MALWARE_SCAN_REQUIRED=false
CLAMSCAN_PATH=
CLAMAV_DATABASE_PATH=

LEX_VIDEO_PROVIDER=jaas
LEX_VIDEO_JAAS_DOMAIN=8x8.vc
LEX_VIDEO_JAAS_APP_ID=
LEX_VIDEO_JAAS_KEY_ID=
LEX_VIDEO_JAAS_PRIVATE_KEY_B64=
LEX_VIDEO_TOKEN_SECRET=same-value-as-render
LEX_VIDEO_API_CONNECT_TIMEOUT_SECONDS=10
LEX_VIDEO_API_TIMEOUT_SECONDS=60
